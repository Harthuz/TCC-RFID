@startuml

actor Gerente
actor Funcionario
actor "Leitor RFID" as RFID

rectangle Sistema {
    usecase "Gerenciar Funcionários" as UC1
    usecase "Visualizar Quantidade de Produtos" as UC2
    usecase "Recebe Notificação Produto Perto da Validade" as UC3
    usecase "Recebe Notificação Produto Acabando" as UC4
    usecase "Visualizar Histórico de Movimentação" as UC5
    usecase "Registrar Entrada/Saída de Produtos" as UC6
}

Gerente --> UC1
Funcionario --> UC2
Funcionario --> UC3
Funcionario --> UC4
Funcionario --> UC5
RFID --> UC6

@enduml
